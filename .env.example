# ── NEXUS environment ─────────────────────────────────────────────
# Copy to .env and adjust. Every value here has a safe local default.

# Server
NEXUS_HOST=0.0.0.0
NEXUS_PORT=8000
# development | production. In production, the app refuses to start if
# NEXUS_SECRET_KEY is still the insecure default below.
NEXUS_ENVIRONMENT=development
# Comma-separated browser origins allowed to call the API. "*" is fine for
# local dev; pin this to your real frontend origin(s) in production.
NEXUS_CORS_ORIGINS=*

# Database.
# Local default (auto-created): SQLite at data/processed/nexus.db
# For Postgres + pgvector (docker-compose):
# NEXUS_DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus
# NEXUS_DATABASE_URL=sqlite:///./data/processed/nexus.db

# Auth
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
NEXUS_SECRET_KEY=change-me-in-production
NEXUS_JWT_TTL_HOURS=8

# LLM provider: mock | openai | anthropic | gemini
# mock = fully local, deterministic, no API key (default; used for all demos)
NEXUS_LLM_PROVIDER=mock
# NEXUS_OPENAI_API_KEY=
# NEXUS_ANTHROPIC_API_KEY=
# NEXUS_GEMINI_API_KEY=
NEXUS_LLM_MODEL=gpt-4o-mini

# Embeddings: hash (local, deterministic) | openai
NEXUS_EMBED_PROVIDER=hash
# NEXUS_EMBED_MODEL=text-embedding-3-small

# Uploads
NEXUS_MAX_UPLOAD_BYTES=10485760
NEXUS_UPLOAD_DIR=./data/processed/uploads

# Job runner (in-process worker threads; swap for SQS/Celery in prod)
NEXUS_WORKER_THREADS=2

# Rate limiting (per-IP fixed window, auth endpoints)
NEXUS_AUTH_RATE_LIMIT=30
